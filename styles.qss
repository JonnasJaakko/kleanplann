/* ===== KleanPlann ===== */

/* Глобальный фон и шрифт */
QMainWindow, QWidget {
    background-color: #f4f6f9;
    font-family: "Segoe UI", "Calibri", sans-serif;
    font-size: 13px;
    color: #2c3e50;
}

/* ===== Кнопки ===== */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    padding: 7px 18px;
    font-size: 13px;
    color: #2c3e50;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #eef3fa;
    border-color: #9db4d0;
}
QPushButton:pressed {
    background-color: #dce6f2;
    border-color: #7a93b5;
}
QPushButton:disabled {
    background-color: #f0f2f5;
    color: #a0a8b0;
    border-color: #e0e4e8;
}

/* Главные кнопки навигации (Далее, Сохранить) */
QPushButton[class="primary"] {
    background-color: #2f6fdb;
    color: #ffffff;
    border: none;
    font-weight: 600;
}
QPushButton[class="primary"]:hover { background-color: #3a7de8; }
QPushButton[class="primary"]:pressed { background-color: #275fc0; }

/* ===== Поля ввода ===== */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 13px;
    color: #2c3e50;
    selection-background-color: #2f6fdb;
    selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #2f6fdb;
    background-color: #fbfdff;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 6px;
    selection-background-color: #eef3fa;
    selection-color: #2c3e50;
    padding: 4px;
}

/* ===== Таблицы ===== */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    gridline-color: #e8ecf1;
    selection-background-color: #cfe0f7;
    selection-color: #1a2b3c;
    alternate-background-color: #f7f9fc;
}
QTableWidget::item {
    padding: 4px 6px;
}
QHeaderView::section {
    background-color: #eef2f7;
    border: none;
    border-bottom: 1px solid #d5dbe3;
    padding: 6px 8px;
    font-weight: 600;
    color: #34495e;
}

/* ===== Списки ===== */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    padding: 4px;
}
QListWidget::item {
    padding: 6px 8px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background-color: #cfe0f7;
    color: #1a2b3c;
}
QListWidget::item:hover {
    background-color: #eef3fa;
}

/* ===== Слайдер ===== */
QSlider::groove:horizontal {
    height: 6px;
    background: #d5dbe3;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #2f6fdb;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover { background: #3a7de8; }

/* ===== Тултипы ===== */
QToolTip {
    background-color: #2c3e50;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ===== Панель инструментов ===== */
QToolBar {
    background-color: #ffffff;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    padding: 4px;
    spacing: 4px;
}
QToolBar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    color: #2c3e50;
}
QToolBar QToolButton:hover { background-color: #eef3fa; }
QToolBar QToolButton:pressed { background-color: #dce6f2; }

/* ===== Заголовки ===== */
QLabel {
    color: #2c3e50;
}
QLabel[class="title"] {
    font-size: 20px;
    font-weight: 700;
    color: #1a2b3c;
}
QLabel[class="section"] {
    font-size: 15px;
    font-weight: 600;
    color: #34495e;
}

/* ===== Диалоги ===== */
QDialog {
    background-color: #f4f6f9;
}
QMessageBox {
    background-color: #f4f6f9;
}

/* ===== Скроллбары ===== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #c3ccd6;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #a8b4c2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #c3ccd6;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #a8b4c2; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }